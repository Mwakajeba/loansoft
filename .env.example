APP_NAME="LoanSoft"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Optional application locale/timezone overrides
# APP_TIMEZONE=UTC
# APP_LOCALE=en
# APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug
# LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# CACHE / QUEUE / SESSION
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false

FILESYSTEM_DISK=local

# REDIS
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS (optional; used by filesystems/queue/logging)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Third-party services (optional)
POSTMARK_TOKEN=
RESEND_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Upload settings
UPLOAD_MAX_FILE_SIZE=51200
UPLOAD_MAX_FILES=10
UPLOAD_STORAGE_DISK=public
UPLOAD_STORAGE_PATH=loan_documents

# SMS / Notification providers
SMS_PROVIDER=kilakona

# Beem SMS
BEEM_SENDER_ID=
BEEM_SECRET_KEY=
BEEM_API_KEY=
BEEM_SMS_URL=https://apisms.beem.africa/v1/send

# Legacy / generic SMS keys
SMS_SENDERID=
SMS_TOKEN=
SMS_KEY=
SMS_URL=https://apisms.beem.africa/v1/send

# Kilakona SMS
KILAKONA_API_KEY=
KILAKONA_API_SECRET=
KILAKONA_CALLBACK_URL=

# SMS events toggles
SMS_EVENT_OTP_VERIFICATION=true
SMS_EVENT_LOAN_DISBURSEMENT=true
SMS_EVENT_LOAN_REPAYMENT=true
SMS_EVENT_LOAN_ARREARS_REMINDER=true
SMS_EVENT_CUSTOMER_NOTIFICATIONS=true
SMS_EVENT_GROUP_NOTIFICATIONS=true
SMS_EVENT_CASH_COLLATERAL=true
SMS_EVENT_MATURE_INTEREST=true

# SMS templates (optional)
SMS_TEMPLATE_OTP_VERIFICATION=
SMS_TEMPLATE_LOAN_DISBURSEMENT=
SMS_TEMPLATE_LOAN_REPAYMENT=
SMS_TEMPLATE_LOAN_ARREARS_REMINDER=
SMS_TEMPLATE_CUSTOMER_NOTIFICATIONS=
SMS_TEMPLATE_GROUP_NOTIFICATIONS=
SMS_TEMPLATE_CASH_COLLATERAL=
SMS_TEMPLATE_MATURE_INTEREST=
